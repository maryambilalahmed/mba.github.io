/**
 * Environment variables template for Phase 2 Supabase integration
 * 
 * Copy this file to .env.local and fill in your values.
 */

# Supabase credentials (from Supabase dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (for admin operations only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: for Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-media
