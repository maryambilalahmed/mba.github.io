# Environment variables template for Phase 2 Supabase integration
# Copy this file to .env.local and fill in your values.

# Supabase credentials (Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (server-only; never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional media bucket (default: portfolio-media)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-media

# Optional site URL for environment-specific integrations
NEXT_PUBLIC_SITE_URL=http://localhost:3000
